# Names only. Set the values on the production host, not in git.
# A code update must not delete or replace values that are already set.

# Injected by the host. Do not commit a database URL.
# DATABASE_URL=

# USDC address that receives x402 license payments. Required for sales.
# X402_PAY_TO=

# Optional. base (default) or base-sepolia.
# X402_NETWORK=base

# Optional. Defaults to https://x402.org/facilitator
# X402_FACILITATOR_URL=

# Optional. Sends license PDF receipts. The PDF still exists without this.
# RESEND_API_KEY=

# Optional. Defaults to Xerographer Fonts <licenses@xerographer.fonts>
# RESEND_FROM=

# ---- Specimen Ledger book store (server-only, never VITE_) ----
STORE_ENV=            # sbx (test copy) | prod (fonts.grok.me only). Unset = store off, /api/store/* 404.
PUBLIC_BASE_URL=      # https://fonts.grok.me in prod
DATABASE_URL=
STRIPE_SECRET_KEY=    # restricted key; rk_test_ for sbx, rk_live_ for prod
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=      # $199.00, tax_behavior exclusive, tax code txcd_35010000
STRIPE_SHIPPING_RATE_STANDARD=   # $6.99
STRIPE_SHIPPING_RATE_EXPEDITED=  # $30.99
STRIPE_SHIPPING_RATE_RUSH=       # $35.99
RPI_BASE_URL=https://open.api.rpiprint.com
RPI_API_AUTH=         # full Authorization header value, starts with "Basic "
RPI_WEBHOOK_SECRET=
CRON_SECRET=
ADMIN_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
STORE_EMAIL_FROM=     # optional, falls back to RESEND_FROM
STORE_REPLY_TO=maxinfeld@gmail.com
ALERT_EMAIL_TO=
DAILY_ORDER_CAP=5
DAILY_DOLLAR_CAP=750
